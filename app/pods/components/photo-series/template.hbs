    <a target="_blank" href="/s/img/save-nyc-spaces-group-photo-nyc-artist-coalition.jpg">
      <img class="photo" src="https://res.cloudinary.com/nycartc/image/fetch/q_auto,f_auto/https://fairrentnyc.nycartc.com/s/img/save-nyc-spaces-group-photo-nyc-artist-coalition--web-02-40d6b2e9b5dc159580227430cfe1e9b2.jpg"/>
