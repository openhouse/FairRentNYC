<div class="container">
  <div class="box-shadow-1dp--filter">
    <div class="slideshow "></div>
  </div>
  <div class="map">
    <LeafletMap @lat={{lat}} @lng={{lng}} @zoom={{zoom}} as |layers|>
      <layers.tile @url="/s/slideshow/tiles/{z}/{x}/{y}.png"/>
    </LeafletMap>
  </div>
  <div class="map-caption text-center strong-font all-caps">
    > 15,000 Shuttered NYC Storefronts
  </div>
</div>
{{yield}}