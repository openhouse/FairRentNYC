<div class="container">
  <div class="map-and-info">

    <div class="box-shadow-1dp--filter">
      <div
        class="slideshow"
        style="
          background-image: url({{photo.sizes.[9].source}});
          background-position: 50% 50%;
        "
        >
        {{!-- {{photo.cssYPercent}} --}}
        {{#if playing}}
          <BsProgress as |pg|>
            <pg.bar
              @value={{cyclePos}}
              @minValue={{0}}
              @maxValue={{cycleLength}}
              @type="info"
             />
          </BsProgress>
        {{/if}}

        <div class="gradient-l-50">
          <div class="slideshow-controls pt-1 pr-2">
            <div class=" btn-group line-height" role="group" aria-label="Slideshow Controls">
              <button
                type="button"
                class="btn btn-outline-primary"
                {{action "prev"}}
                >
                {{fa-icon "caret-left" size="lg"}}
              </button>
              <button
                type="button"
                class="btn btn-outline-primary"
                {{action "togglePlay"}}
                >
                {{#if playing}}
                  {{fa-icon "pause" fixedWidth=true}}
                {{else}}
                  {{fa-icon "play" fixedWidth=true}}
                {{/if}}
              </button>
              <button
                type="button"
                class="btn btn-outline-primary"
                {{action "next"}}
                >
                {{fa-icon "caret-right" size="lg"}}
              </button>
            </div>
            {{#if (is-clipboard-supported)}}
              <CopyButton
               @clipboardText="http://FairRentNYC.com"
               @success={{action "copyLink"}}
               title="copy to clipboard"
               class="btn btn-outline-primary"
              >
                {{fa-icon "sign-out" rotate=270 size=""}}
              </CopyButton>
            {{/if}}
          </div>
          <div class="pt-3 pl-3 slideshow-heading strong-font line-height all-caps">
            Neighbors of NYC's 15,000 Shuttered Storefronts Demand #FairRentNYC
          </div>
          <div class="slideshow-caption light-narrow-font line-height all-caps">
            <b>"</b><span class="d-sm-none">{{photo.quoteXs}}</span><span class="d-none d-sm-inline d-md-none">{{photo.quoteSm}}</span><span class="d-none d-md-inline">{{photo.quoteMd}}</span><b>"</b>
            <div class="pt-1 location"><small class="all-caps line-height">{{#if photo.neighborhood}}{{photo.neighborhood}},{{/if}} {{photo.borough}}</small></div>
          </div>
        </div>
      </div>
    </div>
    <div class="map">
      {{#leaflet-map
        lng=scoredPhotos.firstObject.x
        lat=scoredPhotos.firstObject.y
        zoom=zoom
        minZoom=zoom
        maxZoom=zoom
        scrollWheelZoom=false
        zoomControl=false
        onLoad=(action "initMap")
        as |layers|}}
        <layers.tile @url="/s/slideshow/tiles/{z}/{x}/{y}.png"/>
        <div class="map-caption strong-font all-caps line-height w-100 pb-2 pl-2 pr-2 text-shadow-1dp--white">
          <span class="white-box pl-2 pr-2">
            + 15,000 Shuttered NYC Storefronts, Dec 2019
          </span>
        </div>
      {{/leaflet-map}}


    </div>
    {{#if photo.district.isSponsor}}
     {{!-- photo.district.isSponsor--}}
      <div class="district-info sponsor">
        <div class="d-flex flex-row align-items-center">
          <div
            class="rounded-circle profile-image--sm text-center"
            style="background-image: url({{photo.district.remotePhotoUrl}})">
            <small class="all-caps label">{{fa-icon "trophy"}} Sponsor</small>
          </div>
          <div class="pl-2 flex-grow-1">
            <small class="d-block all-caps line-height pb-1"><b>City Council Member: <span class="nowrap">District {{photo.district.districtNumber}}</span></b></small>
            <div class="member-message">Thank {{photo.district.name}} <span class=""><br></span> for signing on to #FairRentNYC</div>
          </div>
        </div>
        <div class="d-flex w-100 flex-row align-items-stretch all-caps  strong-font pt-2">
          <a class="btn btn-primary text-white flex-fill" href="tel:{{photo.district.phone2}}">{{fa-icon "phone" fixedWidth=true class="d-none d-sm-inline pr-1"}} Call</a>
          <a class="btn btn-primary text-white flex-fill ml-2" target="_blank" href="{{photo.district.emailUrl}}">{{fa-icon "envelope" fixedWidth=true class="d-none d-sm-inline pr-1"}} Email</a>
          <a class="btn btn-primary text-white flex-fill ml-2" href="{{photo.district.tweetUrl}}" target="_blank">{{fa-icon "twitter" fixedWidth=true class="d-none d-sm-inline pr-1"}} Tweet</a>
        </div>
      </div>
    {{else}}
      <div class="district-info">
        <div class="d-flex flex-row align-items-center">
          <div
            class="rounded-circle profile-image--sm"
            style="background-image: url({{photo.district.remotePhotoUrl}})"></div>
          <div class="pl-2 flex-grow-1">
            <small class="d-block all-caps line-height pb-1"><b>City Council Member: <span class="nowrap">District {{photo.district.districtNumber}}</span></b></small>
            <div class="member-message">Ask {{photo.district.name}} <span class="d-sm-inline"><br></span> "Pass #FairRentNYC Bill 1796"</div>
          </div>
        </div>
        <div class="d-flex w-100 flex-row align-items-stretch all-caps  strong-font pt-2">
          <a class="btn btn-primary text-white flex-fill" href="tel:{{photo.district.phone2}}">{{fa-icon "phone" fixedWidth=true class="d-none d-sm-inline pr-1"}} Call</a>
          <a class="btn btn-primary text-white flex-fill ml-2" target="_blank" href="{{photo.district.emailUrl}}">{{fa-icon "envelope" fixedWidth=true class="d-none d-sm-inline pr-1"}} Email</a>
          <a class="btn btn-primary text-white flex-fill ml-2" href="{{photo.district.tweetUrl}}" target="_blank">{{fa-icon "twitter" fixedWidth=true class="d-none d-sm-inline pr-1"}} Tweet</a>
        </div>
      </div>
    {{/if}}
  </div>
</div>
{{!-- preload images--}}
<div class="d-none">
  <img src={{nextPhoto.sizes.[9].source}}>
  <img src={{nextPhoto.district.remotePhotoUrl}}>
  {{currentPhotoIndex}}
</div>
{{yield}}