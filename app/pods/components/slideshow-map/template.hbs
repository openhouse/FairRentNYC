<div class="container">
  <div class="box-shadow-1dp--filter">
    <div
      class="slideshow"
      style="background-image: url({{photo.sizes.[9].source}});"
      >
      <div class="slideshow-caption light-narrow-font line-height all-caps">
        {{#if photo.quote}}
          <b>"</b>{{photo.quote}}<b>"</b>
        {{else}}
          <b>"</b>Pass Commercial Rent Stabilization<b>"</b>
        {{/if}}
        <div class="pt-1 location"><small class="all-caps">{{photo.neighborhood}}, {{photo.borough}}</small></div>

      </div>

    </div>
  </div>
  <div class="map-and-info">
    <div class="map">
      {{#leaflet-map
        lng=scoredPhotos.firstObject.x
        lat=scoredPhotos.firstObject.y
        zoom=zoom
        minZoom=zoom
        maxZoom=zoom
        scrollWheelZoom=false
        zoomControl=false
        onLoad=(action "initMap")
        as |layers|}}
        <layers.tile @url="/s/slideshow/tiles/{z}/{x}/{y}.png"/>
      {{/leaflet-map}}

      <div class="map-caption text-center strong-font all-caps">
        <span class="white-box pr-2 pl-2">
          + 15,000 Shuttered NYC Storefronts
        </span>
      </div>

    </div>
    {{#if photo.district.isSponsor}}
     {{!-- photo.district.isSponsor--}}
      <div class="district-info sponsor">
        <div class="d-flex flex-row align-items-start">
          <div
            class="rounded-circle profile-image--sm text-center"
            style="background-image: url({{photo.district.remotePhotoUrl}})">
            <small class="all-caps label">{{fa-icon "trophy"}} Sponsor</small>
          </div>
          <div class="pl-2 flex-grow-1">
            <small><b class="all-caps">City Council Member: District {{photo.district.districtNumber}}</b></small>
            <div style="line-height: 1.3rem;">Thank {{photo.district.name}} for co-sponsoring #FairRentNYC</div>
          </div>
        </div>
        <div class="d-flex w-100 flex-row align-items-stretch all-caps text-white strong-font pt-2">
          <a class="btn btn-primary flex-fill" href="tel:{{photo.district.phone2}}">{{fa-icon "phone"}}&nbsp; Call</a>
          <a class="btn btn-primary flex-fill ml-2" target="_blank">{{fa-icon "envelope"}}&nbsp; Email</a>
          <a class="btn btn-primary flex-fill ml-2" href="{{photo.district.tweetUrl}}" target="_blank">{{fa-icon "twitter"}}&nbsp; Tweet</a>
        </div>
      </div>
    {{else}}
      <div class="district-info">
        <div class="d-flex flex-row align-items-start">
          <div
            class="rounded-circle profile-image--sm"
            style="background-image: url({{photo.district.remotePhotoUrl}})"></div>
          <div class="pl-2 flex-grow-1">
            <small><b class="all-caps">City Council Member: District {{photo.district.districtNumber}}</b></small>
            <div style="line-height: 1.3rem;">Ask {{photo.district.name}}<br>"Pass #FairRentNYC Bill 1796"</div>
          </div>
        </div>
        <div class="d-flex w-100 flex-row align-items-stretch all-caps text-white strong-font pt-2">
          <a class="btn btn-primary flex-fill" href="tel:{{photo.district.phone2}}">{{fa-icon "phone"}}&nbsp; Call</a>
          <a class="btn btn-primary flex-fill ml-2" target="_blank">{{fa-icon "envelope"}}&nbsp; Email</a>
          <a class="btn btn-primary flex-fill ml-2" href="{{photo.district.tweetUrl}}" target="_blank">{{fa-icon "twitter"}}&nbsp; Tweet</a>
        </div>
      </div>
    {{/if}}
  </div>
</div>
<div class="d-none">
  <img src={{nextPhoto.sizes.[9].source}}>
  <img src={{nextPhoto.district.remotePhotoUrl}}>
  {{currentPhotoIndex}}
</div>
{{yield}}