<div class="container">
  <div class="box-shadow-1dp--filter">
    <div
      class="slideshow"
      style="background-image: url({{photo.sizes.[9].source}});"
      >
      <div class="slideshow-caption light-narrow-font line-height all-caps">
        {{#if photo.quote}}
          <b>"</b>{{photo.quote}}<b>"</b>
        {{else}}
          <b>"</b>Pass Commercial Rent Stabilization<b>"</b>
        {{/if}}

      </div>

    </div>
  </div>
  <div class="map-and-info">
    <div class="map">
      <LeafletMap @lng={{photo.x}} @lat={{photo.y}} @zoom={{zoom}} as |layers|>
        <layers.tile @url="/s/slideshow/tiles/{z}/{x}/{y}.png"/>
      </LeafletMap>

      <div class="map-caption text-center strong-font all-caps">
        <span class="white-box pr-2 pl-2">
          + 15,000 Shuttered NYC Storefronts
        </span>
      </div>

    </div>
    <div class="district-info">
      <div class="d-flex flex-row align-items-start">
        <div
          class="rounded-circle profile-image--sm"
          style="background-image: url({{photo.district.photoUrl}})"></div>
        <div class="pl-2 flex-grow-1">
          <small><b class="all-caps">City Council Member: District {{photo.district.districtNumber}}</b></small>
          <div class="line-height">Ask {{photo.district.name}}</div>
          <div>"Pass #FairRentNYC Bill 1796"</div>
        </div>
      </div>
      <div class="d-flex w-100 flex-row align-items-stretch all-caps text-white strong-font pt-2">
        <a class="btn btn-primary flex-fill" href="tel:{{photo.district.phone2}}">{{fa-icon "phone"}}&nbsp; Call</a>
        <a class="btn btn-primary flex-fill ml-2">{{fa-icon "envelope"}}&nbsp; Email</a>
        <a class="btn btn-primary flex-fill ml-2">{{fa-icon "twitter"}}&nbsp; Tweet</a>
      </div>

    </div>
  </div>
</div>
{{yield}}