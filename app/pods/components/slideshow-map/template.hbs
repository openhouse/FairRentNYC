<div class="container mt-3">
  <h5 class="strong-font all-caps highlight">Tell NY City Council</h5>
  <h1 class="strong-narrow-font all-caps">Pass Commercial Rent Stabilization</h1>
</div>
<div class="box-shadow-1dp--filter">
  <div class="slideshow "></div>
</div>
<div class="map">
  <LeafletMap @lat={{lat}} @lng={{lng}} @zoom={{zoom}} as |layers|>
    <layers.tile @url="/s/slideshow/tiles/{z}/{x}/{y}.png"/>
  </LeafletMap>
</div>

{{yield}}