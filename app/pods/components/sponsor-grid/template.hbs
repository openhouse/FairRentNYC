<div class="container ">
  <div class="pl-3 pr-3">
    <h2 class="all-caps text-success">Progress</h2>
    <p class="">
      By <b>your historic pressure</b>, New York City Council introduced
      <a target="_blank" href="https://legistar.council.nyc.gov/LegislationDetail.aspx?ID=4230081&GUID=B2FF2D24-F642-42A1-BEBB-D8D59E079D99&Options=ID|Text|&Search=1796">the bill</a>
      for Commercial Rent Stabilization.  <b>Now we need the majority of City Council
      to sign on</b>. <b>Call your City Council Member</b>.  Calling counts.
      <a href="tel:212-788-7210">212-788-7210</a>
    </p>

    <div class="pt-3 pb-2 d-flex align-items-center">
      {{fa-icon "trophy" class="text-warning pr-3 d-none d-sm-block" size="2"}}
      <h4 class="strong-font all-caps line-height p-0 m-0 mr-auto d-sm-none">
        NY City Council Members<br> <small>Signed On to <span class="nowrap">Fair Rent NYC Bill</span></small>
      </h4>
      <h3 class="strong-font all-caps line-height p-0 m-0 mr-auto d-none d-sm-block">
        NY City Council Members<br> <small>Signed On to Fair Rent NYC Bill</small>
      </h3>
    </div>

    <p class="lead">
      {{fa-icon "trophy" class="text-warning d-sm-none" size="lg" fixedWidth=true}}

      NYC's diverse community spaces <b class="all-caps">thank</b> City Council
      <b class="all-caps">champions</b> of #FairRentNYC Commercial Rent
      Stabilization bill 1796.  Tap to tweet "thank you."
    </p>

    <div class="mb-3"> {{!--  d-sm-none --}}
      <a
        class="btn btn-primary strong-font all-caps w-100"
        target="_blank"
        href="https://legistar.council.nyc.gov/LegislationDetail.aspx?ID=4230081&GUID=B2FF2D24-F642-42A1-BEBB-D8D59E079D99&Options=ID|Text|&Search=1796"
      >Sponsor Bill #1796</a>
    </div>
    {{!--
    <div class="d-none d-sm-block text-left mb-3">
      <a
        class="btn btn-primary strong-font all-caps nowrap "
        target="_blank"
        href="https://legistar.council.nyc.gov/LegislationDetail.aspx?ID=4230081&GUID=B2FF2D24-F642-42A1-BEBB-D8D59E079D99&Options=ID|Text|&Search=1796"
      >Sponsor Bill #1796</a>
    </div>
    --}}
  </div>
</div>


<GridList @items={{sponsors}} class="round" as |sponsor|>
  <GridItem
    @preview=null
    @category=null
    @classNames=null
    @fitImage=true
    @round=true
    @name={{sponsor.name}}
    @href={{sponsor.href}}
    @src={{sponsor.remotePhotoUrl}}
    @line2={{sponsor.line2}}
  >
    <div class="d-flex align-items-start">
      <div class="pr-1">
        {{fa-icon "trophy" class="text-warning" size="lg"}}
      </div>
      <div class="text-left">
        <div class="strong-font line-height">{{sponsor.name}}</div>
        <div class=" line-height">
          <small>
            Council Member<br>
            District {{sponsor.districtNumber}}
          </small>
        </div>
      </div>
    </div>
  </GridItem>
</GridList>
{{yield}}