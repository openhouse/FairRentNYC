<div class="container">
  <div class="ml-3 mr-3">
    <h3><b class="">{{remainingCount}} more City Council Members needed</b> to pass the #FairRentNYC Bill.</h3>
    <BsProgress as |pg| >
      <pg.bar
        @value={{sponsorCount}}
        @minValue={{0}}
        @maxValue={{26}}
        @showLabel={{true}}
        @type="success"
        @striped={{true}}
        @animate={{true}}
        />
    </BsProgress>
  </div>
</div>
<iframe class="map-iframe box-shadow-1dp mt-2" frameborder="0" src={{lazyMapUrl}} allowfullscreen webkitallowfullscreen mozallowfullscreen oallowfullscreen msallowfullscreen></iframe>
<div class="container ">
  <div class="map-challenge box-shadow-3dp pt-3 pl-3 pr-3">
    <div class="lead">
      <b>Challenge: Turn the map green.</b>
    </div>
    <div>
      <b><a href="tel:212-788-7210">Call City Council Members</a></b> who haven't
      signed on yet at <a href="tel:212-788-7210">212-788-7210</a>. Ask them to "<b>pass Commercial Rent Stabilization bill 1796</b>."
      Council Districts on the map turn bright green as Council Members sign on to #FairRentNYC.
      <b>Let your favorite neighborhood spot know</b> —
      <b>{{!-- Share with friends across the city.--}} <a href="tel:212-788-7210">call City Council</a></b> and turn the map green for #FairRentNYC.
    </div>
    <div class="d-flex justify-content-between strong-font pt-3 pb-4">
      <a class="btn flex-fill btn-primary all-caps" href="tel:212-788-7210">{{fa-icon "phone" fixedWidth=true}} Call</a>
      <a class="btn flex-fill ml-2 btn-info all-caps" target="_blank" rel="noopener noreferrer" href="https://www.facebook.com/sharer/sharer.php?u=https://fairrentnyc.com">{{fa-icon "facebook" fixedWidth=true}} Share</a>
      <a class="btn flex-fill ml-2 btn-info all-caps" target="_blank" rel="noopener noreferrer" href="https://twitter.com/intent/tweet?text=%20Too%20many%20important%20neighborhood%20places%20across%20NYC%20are%20closing%20due%20to%20rent%20increases.%0a%0a%F0%9F%93%A3%20@NYCCouncil%20Pass%20%23FairRentNYC%20Commercial%20Rent%20Stabilization%20Bill%20%231796%20for%20affordable%20diverse%20neighborhoods%20%23StopDisplacement%0a%0a%E2%9C%85%20Join:%20https://fairrentnyc.com%0a%0a@NYCArtC%20@NYCSpeakerCoJo">{{fa-icon "twitter" fixedWidth=true}} Share</a>
    </div>
  </div>
</div>
{{yield}}
