<GridList @items={{orgsSorted}} class="" as |org|>
  <GridItem
    @preview=null
    @category=null
    @classNames="grid-item--baseline"
    @fitImage={{true}}
    @round={{false}}
    @name={{org.name}}
    @href={{org.url}}
    @src={{org.logo}}
  >
    <div class="strong-font text-left line-height all-caps">{{org.name}}</div>
  </GridItem>
</GridList>
{{yield}}