<div class="small text-center container pt-4 pb-4">
  {{#each @orgs as |org|}}
    {{#if org.isActive}}
      {{#if org.url}}
        <a href="{{org.url}}" target="_blank">{{org.name}}</a>
      {{else}}
        {{org.name}}
      {{/if}}
      <span class="dot">•</span>
    {{/if}}
  {{/each}}
</div>
{{yield}}
