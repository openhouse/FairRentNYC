<div class="small text-center container pt-0 pb-3">
  {{#each @orgs as |org|}}
    {{#if org.isActive}}
      {{#if org.url}}
        <a href={{org.url}} target="_blank" rel="noopener noreferrer">{{org.name}}</a>
      {{else}}
        {{org.name}}
      {{/if}}
      <span class="dot">•</span>
    {{/if}}
  {{/each}}
</div>
{{yield}}
