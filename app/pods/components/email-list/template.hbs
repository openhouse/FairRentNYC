<div class="img-background-wrapper" id="join">
  <div class="img-background">
  </div>
</div>
<div class="container">
  <div class="card pastel-bg pastel-blue">
    <h3
      class="card-header all-caps text-white strong-font all-caps line-height"
    ><span class="h1 line-height strong-font">I Stand</span>
      <br />
      for Fair Rent NYC</h3>

    <div class="card-body">
      <!--Email Signup-->
      <div id="mc_embed_signup">
        <form
          action={{mailchimpActionUrl}}
          method="post"
          id="mc-embedded-subscribe-form"
          name="mc-embedded-subscribe-form"
          class="validate"
          target="_self"
          novalidate
        >
          <div id="mc_embed_signup_scroll">
            <input type="hidden" name="u" value={{mailchimpU}} />
            <input type="hidden" name="id" value={{mailchimpId}} />
            {{!
            <div class="indicates-required"><span class="asterisk">*</span> indicates required</div>
            }}
            <div class="mc-field-group form-group">
              <label for="mce-EMAIL">Email Address
                <span class="asterisk">*</span></label>
              <input
                type="email"
                value=""
                name="MERGE0"
                class="form-control required email"
                id="mce-EMAIL"
              />
            </div>
            <div class="row">
              <div class="col pr-1">
                <div class="mc-field-group form-group">
                  <label for="mce-FNAME">First Name </label>
                  <input
                    type="text"
                    value=""
                    name="MERGE1"
                    class="form-control"
                    id="mce-FNAME"
                  />
                </div>
              </div>
              <div class="col pl-1">
                <div class="mc-field-group form-group">
                  <label for="mce-LNAME">Last Name </label>
                  <input
                    type="text"
                    value=""
                    name="MERGE2"
                    class="form-control"
                    id="mce-LNAME"
                  />
                </div>
              </div>
            </div>

            <div class="mc-field-group form-group">
              <label for="mce-ORG">Organization / Project </label>
              <input
                type="text"
                value=""
                name="MERGE6"
                class="form-control"
                id="mce-ORG"
              />
            </div>

            <div class="mc-field-group custom-control custom-checkbox">
              <input
                class="custom-control-input"
                type="checkbox"
                value="1"
                name="group[7224][1]"
                id="mce-group[7224]-7224-0"
                checked
              />
              <label
                class="custom-control-label"
                for="mce-group[7224]-7224-0"
              >List me as a supporter</label>

              {{!
              <ul>
                <li>
                  <input type="checkbox" value="549755813888" name="group[6757][549755813888]" id="mce-group[6757]-6757-0">
                  <label for="mce-group[6757]-6757-0">Show me on the Supporters List</label>
                </li>
              </ul>
              }}
            </div>

            <div class="pt-3">
              <div id="mce-responses" class="clear">
                <div
                  class="response"
                  id="mce-error-response"
                  style="display:none"
                ></div>
                <div
                  class="response"
                  id="mce-success-response"
                  style="display:none"
                ></div>
              </div>
              <!-- real people should not fill this in and expect good things - do not remove this or risk form bot signups-->
              <div
                style="position: absolute; left: -5000px;"
                aria-hidden="true"
              >
                <input
                  type="text"
                  name={{mailchimpBotFieldName}}
                  tabindex="-1"
                  value=""
                />
                <input type="email" name="b_email" tabindex="-1" value="" />
                <textarea name="b_comment" tabindex="-1"></textarea>
              </div>
              {{!-- 
              {{#if isMailchimpConfigured}}
                <p class="small text-muted mt-2 mb-2">{{mailchimpSuccessMessage}}</p>
              {{else}}
                <p class="small text-muted mt-2 mb-2">{{mailchimpMissingMessage}}</p>
              {{/if}}
              --}}
              <div class="clear">
                <input
                  type="submit"
                  value="Join"
                  name="subscribe"
                  id="mc-embedded-subscribe"
                  class="button btn btn-primary w-100 strong-font all-caps"
                  disabled={{unless isMailchimpConfigured true}}
                />
              </div>
              {{!-- 
              {{#if mailchimpFallbackUrl}}
                <p class="small mt-2 mb-0">
                  Having trouble?
                  <a
                    href={{mailchimpFallbackUrl}}
                    target="_blank"
                    rel="noopener noreferrer"
                  >Sign up here</a>.
                </p>
              {{/if}}
              --}}
            </div>
          </div>
        </form>
      </div>
      <!--End mc_embed_signup-->
    </div>
  </div>
</div>
{{yield}}